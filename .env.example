# Tmap JS SDK appKey (browser-exposed; used only by index.html vector SDK)
VITE_TMAP_APP_KEY=your-tmap-sdk-app-key

# Used by packaged native builds so /api requests reach the Vercel functions.
# Leave empty for the hosted web app.
VITE_API_BASE_URL=https://bbaru.vercel.app

# Server-only REST API keys for Vercel Functions and Vite dev proxy
TMAP_APP_KEY=your-tmap-rest-app-key

# 공공데이터포털 인증키 (https://www.data.go.kr)
DATA_GO_KR_KEY=your-data-go-kr-key
